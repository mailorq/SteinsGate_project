# Скопируйте в .env в корне репозитория: его читают и docker compose, и локальный запуск.
# Никогда не коммитьте заполненный файл.

# Обязателен при DEBUG=False, иначе приложение не стартует
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Значение должно быть URL-safe: символ $ docker compose трактует как
# подстановку переменной и портит секрет
SECRET_KEY=

EMAIL_DELIVERY_QUOTA_SECRET=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Host port of the frontend container. PostgreSQL and Redis are not published.
APP_PORT=4173

DB_NAME=steinsgate
DB_USER=steinsgate
DB_PASSWORD=
# DB_HOST/DB_PORT для локального запуска; в compose перекрываются значениями сервиса db
DB_HOST=127.0.0.1
DB_PORT=5432

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_TIMEOUT=10
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Redis для троттлинга, блокировок и кэша; в compose задается сервисом
# REDIS_URL=redis://127.0.0.1:6379/0

# Схема API (/api/docs). По умолчанию включена только при DEBUG=True
# API_DOCS_ENABLED=False
# Число доверенных прокси перед Django. 1 - только nginx из compose;
# увеличьте, если добавили внешний TLS-прокси
# NINJA_NUM_PROXIES=1
# HTTPS-контур: редирект на https, Secure-cookie и HSTS переключаются вместе
# По умолчанию = not DEBUG. Оставьте False, пока перед nginx нет TLS терминатора,
# иначе браузер не отправит Secure-cookie по http и вход перестанет работать
# HTTPS_ENABLED=False
